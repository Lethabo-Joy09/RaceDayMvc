@model System.Text.Json.JsonElement
@{
    ViewData["Title"] = "Event Details";
    var eventId = Model.GetProperty("eventId").GetInt32();
    var eventName = Model.GetProperty("eventName").GetString();
}

<div class="container mt-4">
    <a href="/Participant" class="btn btn-outline-secondary mb-3">&larr; Back to Events</a>
    
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">@eventName</h3>
        </div>
        <div class="card-body">
            <p class="lead">@Model.GetProperty("description").GetString()</p>
            
            <div class="row mt-4">
                <div class="col-md-6">
                    <p><strong>Date:</strong> @Model.GetProperty("eventDate").GetDateTime().ToString("dddd, dd MMMM yyyy HH:mm")</p>
                    <p><strong>Location:</strong> @Model.GetProperty("location").GetString()</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Type:</strong> @Model.GetProperty("eventType").GetString()</p>
                    <p><strong>Distance:</strong> @Model.GetProperty("distance").GetDecimal() km</p>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mt-5">Available Categories</h4>
    
    @if (Model.TryGetProperty("categories", out var categories) && categories.ValueKind == System.Text.Json.JsonValueKind.Array && categories.GetArrayLength() > 0)
    {
        <div class="list-group mt-3">
            @foreach (var cat in categories.EnumerateArray())
            {
                var eventCategoryId = cat.GetProperty("eventCategoryId").GetInt32();
                var categoryName = cat.GetProperty("categoryName").GetString();
                var price = cat.GetProperty("price").GetDecimal();
                var maxParticipants = cat.TryGetProperty("maxParticipants", out var maxP) && maxP.ValueKind != System.Text.Json.JsonValueKind.Null ? maxP.GetInt32() : (int?)null;
                var enrolmentCount = cat.GetProperty("enrolmentCount").GetInt32();

                var isFull = maxParticipants.HasValue && enrolmentCount >= maxParticipants.Value;

                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@categoryName</h5>
                        <small class="text-muted">Distance: @cat.GetProperty("distanceKM").GetDecimal() km</small>
                    </div>
                    <div class="text-end">
                        <h5 class="mb-1">R @price.ToString("F2")</h5>
                        
                        @if (isFull)
                        {
                            <span class="badge bg-danger">Full</span>
                        }
                        else
                        {
                            <form method="post" action="/Participant/Enrol">
                                <input type="hidden" name="eventCategoryId" value="@eventCategoryId" />
                                <input type="hidden" name="eventId" value="@eventId" />
                                <button type="submit" class="btn btn-success btn-sm mt-1">Enrol Now</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-3">No categories have been set up for this event yet.</div>
    }
</div>