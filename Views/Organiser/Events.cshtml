@model System.Text.Json.JsonElement
@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Manage Events</h2>
        <a href="/Organiser/CreateEvent" class="btn btn-success">+ Create New Event</a>
    </div>
    
    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.ValueKind == System.Text.Json.JsonValueKind.Array && Model.GetArrayLength() > 0)
    {
        <table class="table table-striped mt-3 align-middle">
            <thead>
                <tr>
                    <th>Event Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Type</th>
                    <th>Distance</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.EnumerateArray())
                {
                    var eventId = ev.GetProperty("eventId").GetInt32();
                    <tr>
                        <td>@ev.GetProperty("eventName").GetString()</td>
                        <td>@ev.GetProperty("eventDate").GetDateTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@ev.GetProperty("location").GetString()</td>
                        <td>@ev.GetProperty("eventType").GetString()</td>
                        <td>@ev.GetProperty("distance").GetDecimal() km</td>
                        <td>
                            <span class="badge bg-success">@ev.GetProperty("status").GetString()</span>
                        </td>
                        <td>
                            <a href="/Organiser/ManageCategories" class="btn btn-sm btn-info text-white">Categories</a>
                            <a href="/Organiser/EventEnrolments/@eventId" class="btn btn-sm btn-warning text-dark">Enrolments</a>
                            <a href="/Organiser/EditEvent/@eventId" class="btn btn-sm btn-primary">Edit</a>
                            <form action="/Organiser/DeleteEvent/@eventId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info mt-3">
            No events found. Click "Create New Event" to add your first race!
        </div>
    }
    
    <a href="/Organiser" class="btn btn-secondary mt-3">Back to Dashboard</a>
</div>